{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceLab",
  "version": "0.1.1",
  "identifier": "dev.voicelab.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VoiceLab",
        "width": 1080,
        "height": 800,
        "minWidth": 860,
        "minHeight": 600,
        "backgroundColor": "#131210"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "VoiceLab",
    "shortDescription": "Cambiador de voz con IA en tiempo real",
    "longDescription": "Cambia tu voz en tiempo real con IA, solo con la CPU, y úsala como micrófono en Discord, OBS o juegos.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "resources": { "../../voices/": "voices/" },
    "windows": {
      "nsis": {
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
